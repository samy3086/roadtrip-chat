# Set these in your host's dashboard. Never commit real values.
# Names must match what road_trip.py and ChatGoogleGenerativeAI read.

# Gemini key. Needs the Google AI Studio key, NOT a Vertex/service-account key:
# a "gemini-*" model string routes to Vertex AI, which needs GCP credentials.
GOOGLE_API_KEY=

# Tavily key, used by the web_search tool.
TAVILY_API_KEY=