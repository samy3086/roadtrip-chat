# Where visitors' chat requests go: the agent backend on Render (repo: agent/).
# NEXT_PUBLIC_* is inlined at build time, so changing this file requires a
# Vercel redeploy to take effect.
# This is a permanent URL, so it only needs changing if the service moves.
NEXT_PUBLIC_API_URL=https://roadtrip-agent.onrender.com

# Preset the graph so visitors never see the setup form.
NEXT_PUBLIC_ASSISTANT_ID=road_trip

# Empty = no auth scheme. The server has no authentication, so anyone with the
# link can spend the Gemini quota.
NEXT_PUBLIC_AUTH_SCHEME=