# Where visitors' chat requests go: our LangGraph server via the public Cloudflare tunnel.
# NOTE: a trycloudflare.com URL is temporary. When the tunnel restarts, update this value
# (and the same variable in the Vercel project) to the new URL, then redeploy.
NEXT_PUBLIC_API_URL=https://logs-proceeds-defensive-photography.trycloudflare.com

# Preset the graph so visitors never see the setup form.
NEXT_PUBLIC_ASSISTANT_ID=road_trip

# Empty = no auth scheme (our local dev server uses auth type=noop).
NEXT_PUBLIC_AUTH_SCHEME=